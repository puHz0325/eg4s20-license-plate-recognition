  "tests": {
    "teacher_live_clocks_tb": [
      "# PASS teacher_live_clocks: native PLL 75MHz/180deg SDRAM, 25/125MHz video and 24MHz camera"
    ],
    "teacher_roi_tb": [
      "# PASS teacher_roi: exact 4096 bilinear pixels, two-row rounding, 2 lanes, ownership, newest frame, full and bad EOF"
    ],
    "teacher_resize_equiv_tb": [
      "# PASS teacher_resize_equiv: 4096 random OpenCV pixels, odd rounding/extremes, token pauses, partial EOF rejection and reset recovery"
    ],
    "teacher_cdc_tb": [
      "# PASS teacher_cdc: 401 tagged replies, independent clocks, gaps, backpressure, in-flight reset cancellation and recovery"
    ],
    "teacher_live_memory_tb": [
      "# PASS teacher_live_memory: concurrent video/CNN, 960 transactions, RMW masks, stable capture, fair arbitration, refresh and response stalls"
    ],
    "teacher_live_bridge_tb": [
      "# PASS teacher_live_bridge: exact ROI/CRC, RAM latency, randomized stalls, W/V ACK suppression, I parsing, queued stop and corrupt-CRC gate"
    ],
    "teacher_live_bridge_wrong_model": [
      "# PASS teacher_live_bridge: valid-packet wrong-model CRC blocked inference"
    ],
    "teacher_vote_slow_tb": [
      "# PASS teacher_vote_slow: four distinct results over 3 seconds, five-second expiry and no age wrap or replay vote"
    ],
    "lpr_vote_tb": [
      "# PASS 4-of-6 complete-plate voting, duplicate/old tags, isolated errors and winner replacement",
      "# PASS strict plate format, bad length/engine rejection, invalid slot eviction and two-second-equivalent expiry",
      "# PASS frame tag rollover, stale winner expiry under unrelated traffic and reset"
    ],
    "lpr_health_tb": [
      "# PASS health priority: init, camera fault, memory wait, no frame, no result, invalid, pending, confirmed, stale and engine fault",
      "# PASS raw length/text visibility, heartbeat expiry, stale candidate clearing and camera-fault invalidation"
    ],
    "lpr_osd_tb": [
      "# PASS six full VGA OSD frames against independent Pillow oracle: raw short/illegal characters, length23, votes, confirmation and camera fault",
      "# PASS 128-bit atomic frame commit, rapid replacement, video sync alignment and reset"
    ],
    "lpr_vote_osd_tb": [
      "# PASS raw-result to vote to frame-boundary OSD integration, outlier hold and expiry"
    ],
    "teacher_live_system_tb": [
      "# PASS teacher_live_system: 3 full VGA RGB888 frames, grayscale preview and ROI border, exact camera ROI in SDRAM, real teacher 8 layer CRCs and 7 CTC characters, zero underflow"
    ]
  }
